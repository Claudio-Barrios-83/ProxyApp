<Window x:Class="ProxyApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProxyApp.UI.Views"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="ProxyApp"
        Icon="pack://application:,,,/Assets/tray.ico"
        Width="1100"
        Height="680"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right"
                          Content="Activar/Desactivar Engine"
                          IsChecked="{Binding IsEngineEnabled}"
                          Style="{StaticResource EngineToggle}" />
                <StackPanel>
                    <TextBlock Text="ProxyApp" Style="{StaticResource Title}" />
                    <TextBlock Text="El tráfico del proceso sale por el proxy. El resto del sistema no cambia de ruta." Style="{StaticResource Subtitle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="8,4,8,0">
            <TabItem Header="Dashboard">
                <views:DashboardView />
            </TabItem>
            <TabItem Header="Reglas">
                <views:RulesView />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" />
        </Border>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        Grid.Row="1"
                        Width="16"
                        Height="16"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Focusable="False"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ToolTipText="ProxyApp"
                        TrayMouseDoubleClick="TrayIcon_OnDoubleClick">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="P"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Background="#FF3D8BFF" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Activar" Command="{Binding EnableCommand}" />
                    <MenuItem Header="Desactivar" Command="{Binding DisableCommand}" />
                    <Separator />
                    <MenuItem Header="Abrir" Command="{Binding OpenCommand}" />
                    <MenuItem Header="Salir" Command="{Binding ExitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>

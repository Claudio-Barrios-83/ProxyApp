<UserControl x:Class="ProxyApp.UI.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Button DockPanel.Dock="Top" Content="Nueva regla" Command="{Binding NewRuleCommand}" Margin="0,0,0,8" HorizontalAlignment="Left" />
            <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ExitLabel}" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                <TextBlock Text="Ejecutable" Style="{StaticResource FieldLabel}" />
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Content="Examinar…" Command="{Binding BrowseExecutableCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ProcessPattern, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Text="{Binding ExecutablePath}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,-8,0,14" />

                <TextBlock Text="Salida" Style="{StaticResource FieldLabel}" />
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding RefreshExitsCommand}" Margin="8,0,0,0" />
                    <ComboBox ItemsSource="{Binding Exits}"
                              SelectedItem="{Binding SelectedExit}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="Conecta la VPN y pulsa Actualizar. Aparece el adaptador, por ejemplo ProtonVPN (conectada). El resto de los programas sigue la VPN por defecto de Windows."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSocksExit}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                <TextBlock Text="IP del proxy" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Puerto" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Regla activa" IsChecked="{Binding RuleEnabled}" />
                    <CheckBox Content="Omitir red local" IsChecked="{Binding BypassLocal}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="Guardar" Command="{Binding SaveRuleCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                    <Button Content="Eliminar" Command="{Binding DeleteRuleCommand}" Style="{StaticResource DangerButton}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
